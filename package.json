{
  "name": "deers-server-hosting",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "dev:panel": "npm run dev -w @deers/panel",
    "dev:gateway": "npm run dev -w @deers/gateway",
    "dev:worker": "npm run dev -w @deers/worker",
    "test": "vitest run"
  },
  "devDependencies": {
    "prisma": "^6.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@prisma/client": "^6.2.0"
  }
}
